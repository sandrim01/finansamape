generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model clientes {
  id              Int               @id @default(autoincrement())
  nome            String            @db.VarChar(255)
  cnpj            String?           @unique @db.VarChar(18)
  cpf             String?           @unique @db.VarChar(14)
  telefone        String?           @db.VarChar(20)
  email           String?           @db.VarChar(255)
  endereco        String?
  cidade          String?           @db.VarChar(100)
  estado          String?           @db.VarChar(2)
  cep             String?           @db.VarChar(10)
  observacoes     String?
  ativo           Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  contas_receber  contas_receber[]
  listagens_pecas listagens_pecas[]
  maquinas        maquinas[]
  ordens_servico  ordens_servico[]
  vendas          vendas[]

  @@index([cnpj], map: "idx_clientes_cnpj")
  @@index([cpf], map: "idx_clientes_cpf")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contas_pagar {
  id              Int       @id @default(autoincrement())
  fornecedor      String    @db.VarChar(255)
  descricao       String    @db.VarChar(255)
  categoria       String?   @db.VarChar(100)
  valor           Decimal   @db.Decimal(10, 2)
  data_vencimento DateTime  @db.Date
  data_pagamento  DateTime? @db.Date
  status          String?   @db.VarChar(50)
  forma_pagamento String?   @db.VarChar(50)
  observacoes     String?
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  @@index([status], map: "idx_contas_pagar_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contas_receber {
  id              Int             @id @default(autoincrement())
  cliente_id      Int?
  os_id           Int?
  venda_id        Int?
  descricao       String          @db.VarChar(255)
  valor           Decimal         @db.Decimal(10, 2)
  data_vencimento DateTime        @db.Date
  data_pagamento  DateTime?       @db.Date
  status          String?         @db.VarChar(50)
  forma_pagamento String?         @db.VarChar(50)
  observacoes     String?
  created_at      DateTime?       @default(now()) @db.Timestamp(6)
  updated_at      DateTime?       @default(now()) @db.Timestamp(6)
  clientes        clientes?       @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordens_servico  ordens_servico? @relation(fields: [os_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendas          vendas?         @relation(fields: [venda_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status], map: "idx_contas_receber_status")
}

model listagem_pecas_itens {
  id              Int              @id @default(autoincrement())
  listagem_id     Int?
  peca_id         Int?
  quantidade      Decimal          @db.Decimal(10, 2)
  preco_unitario  Decimal          @db.Decimal(10, 2)
  preco_total     Decimal          @db.Decimal(10, 2)
  listagens_pecas listagens_pecas? @relation(fields: [listagem_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pecas           pecas?           @relation(fields: [peca_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model listagens_pecas {
  id                   Int                    @id @default(autoincrement())
  numero_lista         String?                @unique @db.VarChar(50)
  cliente_id           Int?
  maquina_id           Int?
  valor_total          Decimal?               @default(0) @db.Decimal(10, 2)
  status               String?                @default("ABERTA") @db.VarChar(20)
  observacoes          String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  maquina_modelo       String?                @db.VarChar(255)
  listagem_pecas_itens listagem_pecas_itens[]
  clientes             clientes?              @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maquinas             maquinas?              @relation(fields: [maquina_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ordens_servico       ordens_servico[]
}

model maquinas {
  id              Int               @id @default(autoincrement())
  cliente_id      Int?
  tipo            String            @db.VarChar(100)
  modelo          String            @db.VarChar(255)
  numero_serie    String            @unique @db.VarChar(255)
  ano_fabricacao  Int?
  horas_uso       Decimal?          @db.Decimal(10, 2)
  observacoes     String?
  ativo           Boolean?          @default(true)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  listagens_pecas listagens_pecas[]
  clientes        clientes?         @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ordens_servico  ordens_servico[]

  @@index([cliente_id], map: "idx_maquinas_cliente")
}

model ordem_servico_pecas {
  id               Int             @id @default(autoincrement())
  ordem_servico_id Int?
  peca_id          Int?
  quantidade       Decimal         @db.Decimal(10, 2)
  preco_unitario   Decimal         @db.Decimal(10, 2)
  preco_total      Decimal         @db.Decimal(10, 2)
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  ordens_servico   ordens_servico? @relation(fields: [ordem_servico_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pecas            pecas?          @relation(fields: [peca_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ordens_servico {
  id                  Int                   @id @default(autoincrement())
  numero_os           String                @unique @db.VarChar(50)
  cliente_id          Int?
  maquina_id          Int?
  mecanico_id         Int?
  data_abertura       DateTime?             @default(now()) @db.Timestamp(6)
  data_fechamento     DateTime?             @db.Timestamp(6)
  status              String                @db.VarChar(50)
  prioridade          String?               @db.VarChar(50)
  descricao_problema  String
  diagnostico         String?
  servicos_realizados String?
  valor_mao_obra      Decimal?              @default(0) @db.Decimal(10, 2)
  valor_pecas         Decimal?              @default(0) @db.Decimal(10, 2)
  valor_total         Decimal?              @default(0) @db.Decimal(10, 2)
  observacoes         String?
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  updated_at          DateTime?             @default(now()) @db.Timestamp(6)
  km_ida              Decimal?              @default(0) @db.Decimal(10, 2)
  km_volta            Decimal?              @default(0) @db.Decimal(10, 2)
  valor_por_km        Decimal?              @default(0) @db.Decimal(10, 2)
  listagem_pecas_id   Int?
  contas_receber      contas_receber[]
  ordem_servico_pecas ordem_servico_pecas[]
  clientes            clientes?             @relation(fields: [cliente_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  listagens_pecas     listagens_pecas?      @relation(fields: [listagem_pecas_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  maquinas            maquinas?             @relation(fields: [maquina_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios            usuarios?             @relation(fields: [mecanico_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  os_pecas            os_pecas[]

  @@index([cliente_id], map: "idx_os_cliente")
  @@index([data_abertura], map: "idx_os_data")
  @@index([maquina_id], map: "idx_os_maquina")
  @@index([status], map: "idx_os_status")
}

model os_pecas {
  id             Int             @id @default(autoincrement())
  os_id          Int?
  peca_id        Int?
  quantidade     Int
  preco_unitario Decimal         @db.Decimal(10, 2)
  preco_total    Decimal         @db.Decimal(10, 2)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  ordens_servico ordens_servico? @relation(fields: [os_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pecas          pecas?          @relation(fields: [peca_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model pecas {
  id                   Int                    @id @default(autoincrement())
  codigo               String                 @unique @db.VarChar(100)
  nome                 String                 @db.VarChar(255)
  descricao            String?
  categoria            String?                @db.VarChar(100)
  fabricante           String?                @db.VarChar(255)
  quantidade_estoque   Int?                   @default(0)
  estoque_minimo       Int?                   @default(0)
  preco_custo          Decimal?               @db.Decimal(10, 2)
  preco_venda          Decimal?               @db.Decimal(10, 2)
  localizacao          String?                @db.VarChar(255)
  ativo                Boolean?               @default(true)
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  listagem_pecas_itens listagem_pecas_itens[]
  ordem_servico_pecas  ordem_servico_pecas[]
  os_pecas             os_pecas[]
  venda_itens          venda_itens[]

  @@index([codigo], map: "idx_pecas_codigo")
}

model system_logs {
  id           Int       @id @default(autoincrement())
  usuario_id   Int?
  usuario_nome String?   @db.VarChar(255)
  acao         String?   @db.VarChar(255)
  detalhes     String?
  ip           String?   @db.VarChar(50)
  created_at   DateTime? @default(now()) @db.Timestamp(6)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model usuarios {
  id             Int              @id @default(autoincrement())
  nome           String           @db.VarChar(255)
  email          String           @unique @db.VarChar(255)
  senha          String           @db.VarChar(255)
  cargo          String           @db.VarChar(50)
  ativo          Boolean?         @default(true)
  created_at     DateTime?        @default(now()) @db.Timestamp(6)
  updated_at     DateTime?        @default(now()) @db.Timestamp(6)
  ordens_servico ordens_servico[]
  vendas         vendas[]
}

model venda_itens {
  id             Int       @id @default(autoincrement())
  venda_id       Int?
  peca_id        Int?
  quantidade     Int
  preco_unitario Decimal   @db.Decimal(10, 2)
  preco_total    Decimal   @db.Decimal(10, 2)
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  pecas          pecas?    @relation(fields: [peca_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendas         vendas?   @relation(fields: [venda_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model vendas {
  id              Int              @id @default(autoincrement())
  numero_venda    String           @unique @db.VarChar(50)
  cliente_id      Int?
  vendedor_id     Int?
  data_venda      DateTime?        @default(now()) @db.Timestamp(6)
  valor_total     Decimal          @db.Decimal(10, 2)
  desconto        Decimal?         @default(0) @db.Decimal(10, 2)
  valor_final     Decimal          @db.Decimal(10, 2)
  forma_pagamento String?          @db.VarChar(50)
  status          String?          @db.VarChar(50)
  observacoes     String?
  created_at      DateTime?        @default(now()) @db.Timestamp(6)
  updated_at      DateTime?        @default(now()) @db.Timestamp(6)
  contas_receber  contas_receber[]
  venda_itens     venda_itens[]
  clientes        clientes?        @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usuarios        usuarios?        @relation(fields: [vendedor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([cliente_id], map: "idx_vendas_cliente")
}
